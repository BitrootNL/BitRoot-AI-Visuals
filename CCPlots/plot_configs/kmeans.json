{
    "description": "K-Means clustering animation showing cluster assignment and centroid movement, plus a static final-frame PNG. Runs for k=3 and k=4.",
    "key": "kmeans",
    "output_files": {
        "animation": "kmeans_animation_k{n_clusters}{suffix}.gif",
        "static": "kmeans_clustering_k{n_clusters}{suffix}.png"
    },
    "figsize": [8, 6],
    "dpi": 100,
    "params": {
        "n_clusters": [3, 4],
        "n_samples": 200
    },
    "colors": {
        "cluster_0": "primary",
        "cluster_1": "secondary",
        "cluster_2": "brand",
        "cluster_3": "primary@shade(0.6)",
        "cluster_4": "secondary@shade(0.6)",
        "cluster_5": "brand@shade(0.6)",
        "cluster_6": "primary@shade(0.4)",
        "scatter_edge": "on-surface",
        "centroid_fill": "white",
        "centroid_edge": "on-surface",
        "legend_border": "on-surface"
    },
    "text": {
        "en": {
            "title": "KMeans Clustering: Determining Species",
            "xlabel": "Height of a penguin",
            "ylabel": "Weight of a penguin",
            "cluster_label": "Cluster {n}",
            "centroid_label": "Centroid",
            "legend_title": "Clusters"
        },
        "nl": {
            "title": "KMeans-clustering: soorten bepalen",
            "xlabel": "Hoogte van een pingu\u00efn",
            "ylabel": "Gewicht van een pingu\u00efn",
            "cluster_label": "Cluster {n}",
            "centroid_label": "Centro\u00efde",
            "legend_title": "Clusters"
        }
    }
}
