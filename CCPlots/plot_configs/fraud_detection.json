{
    "description": "Decision boundary plot for imbalanced fraud detection using logistic regression with balanced class weights.",
    "key": "fraud_detection",
    "output_files": {
        "default": "fraud_detection_boundary{suffix}.png"
    },
    "figsize": [7, 5],
    "dpi": 100,
    "colors": {
        "class_0": "primary",
        "class_1": "highlight",
        "boundary_start": "primary@tint(0.18)",
        "boundary_end": "highlight",
        "scatter_edge": "secondary_text"
    },
    "text": {
        "en": {
            "title": "Decision Boundary for Fraud Detection",
            "xlabel": "Feature 1 (standardized)",
            "ylabel": "Feature 2 (standardized)",
            "legend_title": "Classes",
            "legend_no_fraud": "No Fraud",
            "legend_fraud": "Fraud"
        },
        "nl": {
            "title": "Beslissingsgrens voor Fraudedetectie",
            "xlabel": "Kenmerk 1 (gestandaardiseerd)",
            "ylabel": "Kenmerk 2 (gestandaardiseerd)",
            "legend_title": "Klassen",
            "legend_no_fraud": "Geen Fraude",
            "legend_fraud": "Fraude"
        }
    }
}
