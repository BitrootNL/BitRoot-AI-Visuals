{
    "description": "Two-panel comparison of underfitting (degree-2 polynomial) vs. overfitting (degree-11 polynomial) with training and test MSE annotations.",
    "key": "overfitting_underfitting",
    "output_files": {
        "default": "overfitting_underfitting{suffix}.png"
    },
    "figsize": [14, 6],
    "dpi": 100,
    "colors": {
        "model_line": "highlight",
        "train_data": "secondary",
        "test_data": "primary"
    },
    "text": {
        "en": {
            "under_title": "Underfitting\nTrain MSE: {train_mse:.2f}, Test MSE: {test_mse:.2f}",
            "over_title": "Overfitting\nTrain MSE: {train_mse:.2f}, Test MSE: {test_mse:.2f}",
            "xlabel": "X",
            "ylabel": "y",
            "train_label": "Training Data",
            "test_label": "Test Data",
            "under_label": "Model (Underfitting)",
            "over_label": "Model (Overfitting)"
        },
        "nl": {
            "under_title": "Underfitting\nTrain MSE: {train_mse:.2f}, Test MSE: {test_mse:.2f}",
            "over_title": "Overfitting\nTrain MSE: {train_mse:.2f}, Test MSE: {test_mse:.2f}",
            "xlabel": "X",
            "ylabel": "y",
            "train_label": "Trainingsgegevens",
            "test_label": "Testgegevens",
            "under_label": "Model (underfitting)",
            "over_label": "Model (overfitting)"
        }
    }
}
